{
  "entities": {
    "UserStore": {
      "title": "UserStore",
      "description": "Store profile and branding settings owned by an authenticated Google user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 220000
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "storeName",
        "logoUrl",
        "ownerName",
        "ownerEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "Sheet": {
      "title": "Sheet",
      "description": "Date-based or batch sheet separating orders and ingredient expenses.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "dateLabel": {
          "type": "string",
          "maxLength": 30
        },
        "sortOrder": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "dateLabel",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "Area": {
      "title": "Area",
      "description": "Delivery or pickup area filter label customizable by the seller.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "sortOrder": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Sellable food or drink item with editable price, custom image, variants, and add-ons.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "basePrice": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 220000
        },
        "variants": {
          "type": "array",
          "description": "Single-select options such as Matang / Mentah."
        },
        "addons": {
          "type": "array",
          "description": "Multi-select or optional add-ons such as Porsi ++ or Cabe ++."
        },
        "isActive": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "basePrice",
        "imageUrl",
        "variants",
        "addons",
        "isActive",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food order belonging to a sheet and area with payment status and notes.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sheetId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "areaId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "areaName": {
          "type": "string",
          "maxLength": 50
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "items": {
          "type": "array",
          "description": "Ordered menu line items."
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "isPaid": {
          "type": "boolean"
        },
        "totalAmount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "sheetId",
        "areaId",
        "areaName",
        "customerName",
        "items",
        "notes",
        "isPaid",
        "totalAmount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Ingredient or operational cost entry for profit calculation per sheet.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sheetId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "unitNote": {
          "type": "string",
          "maxLength": 40
        },
        "amount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "sheetId",
        "name",
        "unitNote",
        "amount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserStore" },
      "description": "Store profile and branding settings for each authenticated user."
    },
    "/users/{userId}/sheets/{sheetId}": {
      "schema": { "$ref": "#/entities/Sheet" },
      "description": "Order sheets organized by date or batch."
    },
    "/users/{userId}/areas/{areaId}": {
      "schema": { "$ref": "#/entities/Area" },
      "description": "Customizable delivery/pickup area labels."
    },
    "/users/{userId}/menuItems/{menuItemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Editable food menu items and pricing."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders under a user store."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Ingredient and modal cost items per sheet."
    }
  }
}
